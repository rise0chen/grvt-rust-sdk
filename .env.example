# GRVT Rust SDK — environment variable template
#
# Copy to `.env` and set values locally. Secret fields are intentionally left empty
# in this repo; variable names match what a real `.env` uses (no dummy secrets here).

# Environment: prod | testnet | staging | dev (default: testnet if unset)
GRVT_ENV=testnet

# API key — set at least one of the following
GRVT_API_KEY=
GRVT_API_KEY_TESTNET=
GRVT_API_KEY_PROD=

# Sub-account ID — set at least one of the following
GRVT_TRADING_ACCOUNT_ID=
GRVT_SUB_ACCOUNT_ID=

# EIP-712 signing (hex-encoded; optional 0x prefix)
GRVT_PRIVATE_KEY=

# Optional override (otherwise defaults follow GRVT_ENV)
# GRVT_CHAIN_ID=
